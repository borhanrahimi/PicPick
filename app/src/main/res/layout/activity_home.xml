<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" style="@style/PageTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_subtitle" style="@style/BodyText" android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/import_photos" style="@style/ActionButton" app:icon="@drawable/ic_add" android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:layout_weight="1">
                <TextView android:id="@+id/reviewProgress" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BodyText" android:accessibilityLiveRegion="polite" />
                <ProgressBar android:id="@+id/reviewProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:progressTint="@color/brand" />
                <FrameLayout android:id="@+id/imageContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="260dp" android:layout_marginTop="16dp" android:background="@drawable/bg_photo_card" android:clipToOutline="true" android:padding="8dp">
                    <ImageView android:id="@+id/imageViewMain" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:id="@+id/reviewEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:gravity="center" android:textColor="@color/ink" android:accessibilityLiveRegion="polite" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnReviewSkipped" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_skipped" style="@style/ActionButton" android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>
                <TextView android:id="@+id/currentPhotoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BodyText" android:gravity="center" android:maxLines="1" android:ellipsize="middle" android:paddingTop="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:gravity="center">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageButton android:id="@+id/btnTrash" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/bg_red_circle" android:src="@drawable/ic_trash_white" android:scaleType="fitCenter" android:contentDescription="@string/trash_action" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/trash_action" android:textColor="@color/ink" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageButton android:id="@+id/btnSkip" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/bg_blue_circle" android:src="@drawable/ic_skip_white" android:scaleType="fitCenter" android:contentDescription="@string/skip_action" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/skip_action" android:textColor="@color/ink" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageButton android:id="@+id/btnUndo" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/bg_dark_circle" android:src="@drawable/ic_undo" android:scaleType="fitCenter" android:contentDescription="@string/undo_action" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/undo_action" android:textColor="@color/ink" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageButton android:id="@+id/btnKeep" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:background="@drawable/bg_green_circle" android:src="@drawable/ic_keep_white" android:scaleType="fitCenter" android:contentDescription="@string/keep_action" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/keep_action" android:textColor="@color/ink" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_navigation" />
</LinearLayout>