<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" style="@style/PageTitle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_subtitle" style="@style/BodyText" android:layout_marginTop="4dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/appearance" style="@style/SectionTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/appearance_hint" style="@style/BodyText" android:layout_marginTop="8dp" />
            <RadioGroup android:id="@+id/themeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_photo_card" android:padding="12dp">
                <RadioButton android:id="@+id/themeSystem" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/theme_system" android:textColor="@color/ink" />
                <RadioButton android:id="@+id/themeLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/theme_light" android:textColor="@color/ink" />
                <RadioButton android:id="@+id/themeDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/theme_dark" android:textColor="@color/ink" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/your_library" style="@style/SectionTitle" android:layout_marginTop="24dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/show_samples" android:textColor="@color/ink" android:layout_marginTop="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/samples_hint" style="@style/BodyText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/import_photos" style="@style/ActionButton" app:icon="@drawable/ic_add" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/import_hint" style="@style/BodyText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_controls" style="@style/SectionTitle" android:layout_marginTop="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_csv" style="@style/ActionButton" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset_confirm" style="@style/ActionButton" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_hint" style="@style/BodyText" android:layout_marginTop="16dp" android:background="@drawable/bg_soft" android:padding="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_app" style="@style/BodyText" android:layout_marginTop="24dp" android:gravity="center" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_navigation" />
</LinearLayout>